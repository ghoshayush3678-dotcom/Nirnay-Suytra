# GEMINI_API_KEY: Used by server.ts (/api/gemini/review) when running with a backend server.
# Never bundled into the public dist/ browser code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Optional for pure static deployments (dist/ folder without server.ts).
# WARNING: Any VITE_* variable set at build time is embedded into the public browser bundle.
VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Firebase Client Overrides (Defaults to provisioned firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID=""
